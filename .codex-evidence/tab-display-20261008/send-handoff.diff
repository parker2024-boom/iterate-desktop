+        g.select(3).unwrap();
+        assert!(!g.restore_send_handoff(1, &pending));
+        assert_eq!(g.active_pid, Some(3));
+        g.select(2).unwrap();
+        g.tabs[0].request_id = "new-request".into();
+        assert!(!g.restore_send_handoff(1, &pending));
+        assert_eq!(g.active_pid, Some(2));
+    }
+
